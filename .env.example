# ---------------------------------------------------------------------------
# LogiSQL-Agent environment configuration
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database -------------------------------------------------------------------
# Local zero-setup demo (default). A synthetic Olist-like database is created
# automatically on first API start.
DATABASE_URL=sqlite+aiosqlite:///./data/logisql_demo.db
DATABASE_SCHEMA=public

# Supabase production example (use your pooled or direct connection string):
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Tables exposed to the agent. Keep this list tight.
ALLOWED_TABLES=orders,order_items,products,sellers,order_payments

# Groq / LLM -----------------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# Agent safety & limits ------------------------------------------------------
MAX_RETRIES=3
DEFAULT_ROW_LIMIT=200
MAX_ROW_LIMIT=1000
QUERY_TIMEOUT_MS=15000
SCHEMA_CACHE_TTL_SECONDS=300

# API ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_BASE_URL=http://localhost:8000
# In-process backpressure for expensive LLM queries.
MAX_CONCURRENT_QUERIES=4
QUERY_QUEUE_TIMEOUT_SECONDS=30

# LangSmith ------------------------------------------------------------------
# Enable tracing by setting these. LangGraph/LangChain pick them up
# automatically. See https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=logisql-agent
